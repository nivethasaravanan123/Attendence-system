{
  "info": {
    "name": "Mini Attendance Management System - Twite AI API Collection",
    "description": "Complete Postman API Collection for testing and evaluation of the Mini Attendance System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Employee Management",
      "item": [
        {
          "name": "List All Employees (with Filters & Pagination)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/employees?page=1&limit=10&department=All&status=Active&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "department", "value": "All" },
                { "key": "status", "value": "Active" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Employee by ID / Employee Code",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/employees/EMP-001", "host": ["{{baseUrl}}"], "path": ["api", "employees", "EMP-001"] }
          }
        },
        {
          "name": "Create New Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP-011\",\n  \"employee_name\": \"Naveen Krishnan\",\n  \"email\": \"naveen.k@twiteai.com\",\n  \"mobile_number\": \"+91 98450 12345\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Backend Engineer\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_name\": \"Naveen K (Senior)\",\n  \"designation\": \"Staff Software Engineer\",\n  \"status\": \"Active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/employees/EMP-011", "host": ["{{baseUrl}}"], "path": ["api", "employees", "EMP-011"] }
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/employees/EMP-011", "host": ["{{baseUrl}}"], "path": ["api", "employees", "EMP-011"] }
          }
        },
        {
          "name": "Get Department List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/employees/departments", "host": ["{{baseUrl}}"], "path": ["api", "employees", "departments"] }
          }
        }
      ]
    },
    {
      "name": "Attendance Tracking",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP-001\",\n  \"attendance_date\": \"2026-09-04\",\n  \"check_in_time\": \"09:00:00\",\n  \"check_out_time\": \"18:00:00\",\n  \"attendance_status\": \"Present\",\n  \"notes\": \"Marked from Postman test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendance", "host": ["{{baseUrl}}"], "path": ["api", "attendance"] }
          }
        },
        {
          "name": "Get Attendance Records (Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?page=1&limit=10&department=All&status=All",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/attendance/summary", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "summary"] }
          }
        },
        {
          "name": "Get Employee-Wise Attendance History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/attendance/employee/EMP-001", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "employee", "EMP-001"] }
          }
        },
        {
          "name": "Export Attendance CSV",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/attendance/export", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "export"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"] }
          }
        }
      ]
    }
  ]
}
